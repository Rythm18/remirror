{
  "name": "@remirror/extension-document-diff",
  "version": "3.0.0",
  "description": "Compare ProseMirror documents and compute structured diffs using Myers algorithm",
  "keywords": [
    "remirror",
    "extension",
    "diff",
    "myers",
    "comparison"
  ],
  "homepage": "https://github.com/remirror/remirror/tree/HEAD/packages/remirror__extension-document-diff",
  "repository": {
    "type": "git",
    "url": "https://github.com/remirror/remirror.git",
    "directory": "packages/remirror__extension-document-diff"
  },
  "license": "MIT",
  "contributors": [
    "Remirror Contributors"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/remirror-extension-document-diff.js",
      "require": "./dist/remirror-extension-document-diff.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/remirror-extension-document-diff.cjs",
  "module": "./dist/remirror-extension-document-diff.js",
  "types": "./dist-types/index.d.ts",
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "build": "remirror-cli build"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@remirror/core": "3.0.2"
  },
  "devDependencies": {
    "@remirror/cli": "1.1.0",
    "@remirror/pm": "3.0.1"
  },
  "peerDependencies": {
    "@remirror/pm": "^3.0.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/remirror-extension-document-diff.d.ts",
        "import": "./dist/remirror-extension-document-diff.js",
        "require": "./dist/remirror-extension-document-diff.cjs"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/remirror-extension-document-diff.cjs",
    "module": "./dist/remirror-extension-document-diff.js",
    "type": "module",
    "types": "./dist/remirror-extension-document-diff.d.ts"
  },
  "@remirror": {
    "sizeLimit": "15 KB"
  }
}
